# Copy to .env.local (gitignored) and fill in:   cp .env.example .env.local
# Loaded by direnv (.envrc), by every script in ./scripts, and by Vite at build
# time. Alternatively, put the same keys under [env] in mise.local.toml
# (also gitignored). See docs/apple-developer-setup.md.

# ---------------------------------------------------------------------------
# Embedded into the extension at build time (client-side, visible to users).
# ---------------------------------------------------------------------------

# iCloud container identifier, e.g. iCloud.com.example.cloudkit-todo
CLOUDKIT_CONTAINER_ID=

# development | production
CLOUDKIT_ENVIRONMENT=development

# CloudKit *API token* (CloudKit Console > container > Tokens & Keys > API Tokens).
# Its "Sign In Callback" must be a URL redirect to: https://<EXTENSION_ID>.chromiumapp.org/
CLOUDKIT_API_TOKEN=

# Base64 DER public key. Pins the extension ID across machines, Chrome and Edge.
# Generated by:  mise run ext:key   (the private key stays in .keys/, gitignored)
EXTENSION_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# Used only by local tooling (cktool). NEVER embedded in the extension.
# ---------------------------------------------------------------------------

# Apple Developer Team ID (10 chars), used by the cktool schema commands.
APPLE_TEAM_ID=

# The CloudKit *management token* is NOT stored here. cktool keeps it in the
# macOS keychain:   mise run ck:token
