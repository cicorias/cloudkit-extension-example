{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(mise run test)",
      "Bash(mise run check)",
      "Bash(mise run build)",
      "Bash(mise run doctor)",
      "Bash(mise run ext:info)",
      "Bash(mise run secrets:scan)",
      "Bash(mise tasks)",
      "Bash(pnpm exec tsc --noEmit)",
      "Bash(pnpm exec vitest run:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "Bash(mise run ck:import)",
      "Bash(mise run ck:reset)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.envrc)",
      "Read(./mise.local.toml)",
      "Read(./.keys/**)",
      "Read(./**/*.pem)",
      "Bash(cat .env.local:*)",
      "Bash(cat .envrc:*)"
    ]
  }
}
